{
  // The hosted editorial desk. It works on the content store (the same R2 bucket the site reads).
  // Its address carries a secret, set once with: npx wrangler secret put DESK_KEY
  "name": "legacy-league-desk",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // the editor's article field (Tiptap), bundled by npm run build:editor and served as /<key>/editor/app.js
  "rules": [{ "type": "Text", "globs": ["**/*.bundle.txt"], "fallthrough": true }],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "legacy-league-content" }],
  // push alerts: the app's devices, the alerts and who got which (src/push.js). Firebase signs in with the Worker
  // secret FCM_SERVICE_ACCOUNT (the service account's JSON): npx wrangler secret put FCM_SERVICE_ACCOUNT < file.json
  "d1_databases": [{ "binding": "PUSH", "database_name": "legacy-league-push", "database_id": "3d859904-4661-4cd1-a9f3-41c8136d84bd" }],
  // scheduled stories and alerts go out on time (publishDue and alertsDue in src/index.js)
  "triggers": { "crons": ["*/5 * * * *"] },
  // sign-in for the Studio and the photo pages (see ACCESS_SETUP.md): the Cloudflare Access team and the
  // Application Audience tag of its "Content Studio" application. Not secrets. Remove both to turn the check off.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://broad-mouse-18a9.cloudflareaccess.com",
    "ACCESS_AUD": "e82a48d218a777a910a1e4bccedaac915a0e7407e72ddc22615e8f6b29a39939",
    // the People page keeps the Access rule "Content Studio editors" equal to the people list; it also needs the
    // Worker secret CF_API_TOKEN (an account token limited to Access): npx wrangler secret put CF_API_TOKEN
    "CF_ACCOUNT_ID": "7b3a32089e99a0353b7cf77605ef3133",
    "ACCESS_POLICY_ID": "9b6cd17c-51a5-436c-85fa-b18cb1313159"
  }
}
